# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: port to run the server on locally (default 3000)
PORT=3000

# --- Only needed if you want the agent to make OUTBOUND calls too ---
# Get these from https://console.twilio.com (Account SID + Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567
# Your server's public URL (ngrok URL while testing, real domain in production) — NO trailing slash
BASE_URL=https://your-public-url.ngrok-free.app
